<Window x:Class="pizza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pizza"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFF17C2A"/>
                <GradientStop Color="#FFAFA900" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <ListBox x:Name="lbox_pizza" Margin="0,0,370,217" SelectionChanged="kivalsztas">
            <ListBox.Background>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </ListBox.Background>
        </ListBox>
        <TextBox x:Name="tbox_hozzadas" TextAlignment="Center" HorizontalAlignment="Left" Margin="435,10,0,0" TextWrapping="Wrap" Text="Új pizza" VerticalAlignment="Top" Width="335" Height="49">
            <TextBox.Background>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </TextBox.Background>
        </TextBox>
        <Button x:Name="btn_hozzadas" Content="Hozzáadás" HorizontalAlignment="Left" Margin="516,79,0,0" VerticalAlignment="Top" Height="45" Width="180" FontSize="18" FontWeight="Bold" Click="ujPizzaHozzadas" Background="#FF29CE1C"/>
        <Button x:Name="btn_torles" Content="Kiválasztott pizza törlése" HorizontalAlignment="Left" Margin="516,153,0,0" VerticalAlignment="Top" Height="45" Width="180" FontSize="14" FontWeight="Bold" Click="pizzaTorles" Background="#FFAB2F2F"/>
        <TextBox x:Name="tbox_kivalasztott" HorizontalAlignment="Left" Margin="10,238,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="150" Height="30">
            <TextBox.Background>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </TextBox.Background>
        </TextBox>
        <TextBox x:Name="tbox_meret" HorizontalAlignment="Left" Margin="180,238,0,0" TextWrapping="Wrap" Text="Méret" VerticalAlignment="Top" Width="150" Height="30">
            <TextBox.Background>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </TextBox.Background>
        </TextBox>
        <Button x:Name="btn_rendeles" Content="Rendelés" HorizontalAlignment="Left" Margin="358,238,0,0" VerticalAlignment="Top" Height="30" Width="72" RenderTransformOrigin="-0.238,0.535" Click="ujRendeles" Background="#FF35B2F3" FontWeight="Bold"/>
        <ListBox x:Name="lbox_rendelesek" Margin="0,302,370,0">
            <ListBox.Background>
                <SolidColorBrush Color="White" Opacity="0.5"/>
            </ListBox.Background>
        </ListBox>

    </Grid>
</Window>
